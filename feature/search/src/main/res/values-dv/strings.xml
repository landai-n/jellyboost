<resources>
    <string name="search_field_label">ފިލްމު، ސީރީޒް އަދި އެޕިސޯޑް ހޯދާ</string>
    <string name="search_clear">ސާފުކުރޭ</string>

    <string name="search_section_movies">ފިލްމުތައް</string>
    <string name="search_section_series">ސީރީޒްތައް</string>
