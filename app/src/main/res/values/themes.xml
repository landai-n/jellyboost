<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark-locked, deliberately and permanently, even though the app gained a light scheme in
        M14: Compose owns every in-app colour, and this theme covers only the window background
        and the pre-Compose splash frame — both of which draw before DataStore can say which
        scheme the user picked (docs/features/theme.md). MainActivity corrects the system-bar
        icons as soon as the preference resolves; this is the frame before that.

        AppCompat-derived, and for one reason only: the Cast chooser/controller dialogs are
        DialogFragments hosted by this activity, so MediaRouter themes them from *this* theme
        and AppCompatDialog then requires the AppCompatTheme attributes to be there. Nothing
        else in the app is AppCompat — no AppCompat views, no AppCompatActivity. NOT the
        DayNight variant: a values-night split here would re-theme those Cast dialogs on the
        *system's* night setting rather than the app's own, which is the wrong input.
    -->
    <style name="Theme.Jellyboost" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- What tints the Cast dialogs' controls; Compose never reads it. -->
        <item name="colorAccent">@color/primary</item>
    </style>

    <style name="Theme.Jellyboost.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Jellyboost</item>
        <!--
            Theme.SplashScreen's DayNight parent otherwise follows the SYSTEM's light/dark setting
            (android:Theme.DeviceDefault.DayNight), independently of this app's own theme preference.
            On a system in light mode that draws dark status-bar icons over our dark splash background
            for the brief window before postSplashScreenTheme takes over. Force it dark to match.
        -->
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
