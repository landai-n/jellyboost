<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The back button's description, and the label of the player error state's one action —
         both close the player and return to where the user came from. -->
    <string name="player_back">Close player</string>
    <string name="player_pause">Pause</string>
    <string name="player_rewind">Skip back 10 seconds</string>
    <string name="player_forward">Skip forward 30 seconds</string>

    <!--
      The tap surface over the video. It is the only way back to the controls once they have hidden,
      so it carries a real accessibility action rather than a bare touch gesture (audit CR-1).
    -->
    <string name="player_show_controls">Show player controls</string>

    <!-- The swipe indicator, which doubles as the announcement of what the swipe just changed. -->
    <string name="player_volume_percent">Volume %1$d percent</string>
    <string name="player_brightness_percent">Brightness %1$d percent</string>

    <!--
      The mid-playback rebuffer spinner's label. `isBuffering` had no UI at all before the
      accessibility pass: a stall showed a frozen frame and said nothing (audit CR-3).
    -->
    <string name="player_buffering">Buffering</string>

    <!--
      The seek bar's name, and the sentence the clock and the seek bar both speak: %1$s is the
      position, %2$s the duration, each already in words ("12 minutes 34 seconds of 45 minutes").
      Spoken rather than "12:34", which a speech engine reads as a time of day.
    -->
    <string name="player_seek">Seek</string>
    <string name="player_position_of_duration">%1$s of %2$s</string>

    <plurals name="player_spoken_hours">
        <item quantity="one">%d hour</item>
