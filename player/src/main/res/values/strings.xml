    <!--
      Every dialog button is an app string rather than `android.R.string.cancel` (B10): the system
      string follows the device locale, and this app is English-only today, so a French device
      showed "Annuler" next to an English "Create" in the same dialog. One string shared by every
      SyncPlay dialog's dismiss button so the two can never drift apart again.
    -->
    <string name="player_syncplay_cancel">Cancel</string>

