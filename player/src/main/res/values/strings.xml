    <string name="player_syncplay_leave_title">Leave this group?</string>
    <string name="player_syncplay_leave_body">Playback carries on here, on its own. Rejoining means picking the group again.</string>

    <!--
      This module's dialogs take their dismiss label from `:core:ui`'s `action_cancel` (audit
      2026-08-08, DUP-6) — an app string rather than `android.R.string.cancel` for the reason B10
      recorded: the system string follows the device locale, so a French device showed "Annuler"
      next to an English "Create" in the same dialog. It is now one string for the whole app rather
      than one per module, which is the same argument one level up.
    -->

    <plurals name="player_syncplay_participants">
        <item quantity="one">%d person watching</item>
        <item quantity="other">%d people watching</item>
    </plurals>

    <!--
      B6: the groups screen used to show only this count. `player_syncplay_groups_participants_more`
      is what a row falls back to once the joined names stop fitting — `%1$s` is the names shown,
      `%2$d` how many more there are.
    -->
    <string name="player_syncplay_groups_participants_more">%1$s +%2$d more</string>

