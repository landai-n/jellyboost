<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="search_field_label">Search movies, shows and episodes</string>
    <string name="search_clear">Clear</string>

    <!-- Result sections -->
    <string name="search_section_movies">Movies</string>
    <string name="search_section_series">Shows</string>
    <string name="search_section_episodes">Episodes</string>

    <!-- States -->
    <!-- Shown under the field once a search has matched something, and announced when it changes:
         results appear below a field the user is still typing in, so the count is the only thing
         that says the page filled up (accessibility audit 2026-08-05, A11Y-09). -->
    <plurals name="search_result_count">
        <item quantity="one">%1$d result</item>
        <item quantity="other">%1$d results</item>
    </plurals>
    <string name="search_prompt">Type to search your libraries.</string>
    <string name="search_no_results">Nothing matched “%1$s”.</string>

    <!-- Errors -->
    <string name="search_error_network">Can\'t reach your server. Check your connection and try again.</string>
    <string name="search_error_unauthorized">Your session expired. Sign in again to continue.</string>
    <string name="search_error_not_found">That item is no longer on the server.</string>
    <string name="search_error_server">The server returned an error.</string>
    <string name="search_error_server_with_code">The server returned an error (%1$d).</string>
    <string name="search_error_storage">Couldn\'t read local data.</string>
    <string name="search_error_unknown">Something went wrong while searching.</string>
</resources>
