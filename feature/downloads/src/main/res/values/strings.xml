<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="downloads_tab_downloaded">Downloaded</string>
    <string name="downloads_tab_queue">Queue</string>
    <string name="downloads_wifi_only">Wi‑Fi only</string>

    <!-- Screen header (top-level tab, 2026 refresh — no back button). 2026-refresh: pending localization -->
    <string name="downloads_screen_title">Downloads</string>

    <!-- Downloaded tab grouping -->
    <!-- Heading over every standalone film, shown only once at least one series group is also on
         the tab — see DownloadGroup.isMoviesSection. -->
    <string name="downloads_group_movies">Movies</string>

    <!-- Storage header -->
    <string name="downloads_storage_summary">%1$s used · %2$s free</string>
    <!-- The compact storage card's free-space caption (2026 refresh), standing on its own baseline
         row beside the used-bytes figure rather than joined into one sentence.
         2026-refresh: pending localization -->
    <string name="downloads_storage_free">%1$s free</string>

    <!-- Wide-layout tablet stat panels (2026 refresh, spec "4d Downloads"). Eyebrow labels are
         uppercased in code. -->
    <!-- 2026-refresh: pending localization -->
    <string name="downloads_stat_on_device">On this device</string>
    <!-- 2026-refresh: pending localization -->
    <string name="downloads_stat_queue">Queue</string>
    <!-- 2026-refresh: pending localization -->
    <string name="downloads_stat_network">Network</string>
    <!-- "ON THIS DEVICE" panel's caption: available space against the storage total.
         2026-refresh: pending localization -->
    <string name="downloads_stat_free_of">%1$s free of %2$s</string>
    <!-- "QUEUE" panel's value line: how many rows are queued and how much is still to transfer.
         2026-refresh: pending localization -->
    <plurals name="downloads_stat_queue_items">
        <item quantity="one">%1$d item · %2$s</item>
        <item quantity="other">%1$d items · %2$s</item>
    </plurals>
    <!-- "QUEUE" panel's speed/ETA caption — hedged like every other ETA on this screen
         (downloads_eta_approx), since the queue's aggregate remainder can carry the same
         projection/ceiling uncertainty any one row's own total does.
         2026-refresh: pending localization -->
    <string name="downloads_stat_eta_about">about %1$s left</string>
    <!-- "NETWORK" panel's caption, shown only while Wi‑Fi-only is on.
         2026-refresh: pending localization -->
    <string name="downloads_stat_network_helper">Paused automatically on cellular</string>

    <!-- Row actions -->
    <string name="downloads_action_delete">Delete download</string>
    <string name="downloads_action_cancel">Cancel download</string>
    <string name="downloads_action_pause">Pause download</string>
    <string name="downloads_action_resume">Resume download</string>
    <string name="downloads_action_move_up">Move up the queue</string>
    <string name="downloads_action_move_down">Move down the queue</string>

    <!-- Queue tab bulk actions -->
    <string name="downloads_action_pause_all">Pause all</string>
    <string name="downloads_action_resume_all">Resume all</string>
    <string name="downloads_action_cancel_all">Cancel all</string>

    <!-- Cancel-all confirmation. The message names what is NOT affected: finished downloads live on
         the other tab and are never in the queue list. -->
    <plurals name="downloads_cancel_all_dialog_title">
        <item quantity="one">Cancel this download?</item>
        <item quantity="other">Cancel all %1$d downloads?</item>
    </plurals>
    <string name="downloads_cancel_all_dialog_message">The queue is emptied and any partly downloaded files are removed. Finished downloads are not affected.</string>
    <string name="downloads_cancel_all_dialog_confirm">Cancel downloads</string>
    <string name="downloads_cancel_all_dialog_dismiss">Keep</string>

    <!-- Delete confirmation (Downloaded tab) -->
    <string name="downloads_delete_dialog_title">Delete %1$s?</string>
    <string name="downloads_delete_dialog_message">The downloaded files are removed from this device. You can download it again later.</string>
    <string name="downloads_delete_dialog_confirm">Delete</string>
    <string name="downloads_delete_dialog_cancel">Cancel</string>

    <!-- Queue row status line -->
    <string name="downloads_progress_of">%1$s of %2$s</string>
    <!-- The size is a projection: measured from the stream, or seeded from finished episodes of the same show. -->
    <string name="downloads_progress_of_approx">%1$s of ~%2$s</string>
    <!-- Nothing but the enqueue-time upper bound: the encoder routinely lands well under it. -->
    <string name="downloads_progress_of_capped">%1$s of up to %2$s</string>
    <!-- The same projection, alone, for a row that has not started transferring yet. -->
    <string name="downloads_size_approx">~%1$s</string>
    <!-- The same ceiling, alone, for a row that has not started transferring yet. -->
    <string name="downloads_size_capped">up to %1$s</string>
    <string name="downloads_speed">%1$s/s</string>
    <string name="downloads_eta">%1$s left</string>
    <!-- Same hedge as downloads_size_approx: the total behind the ETA is a ceiling, not a measured
         figure, so the time left it implies is stated as an estimate too. -->
    <string name="downloads_eta_approx">~%1$s left</string>
    <!-- A re-encoded download's marker, appended as the last segment of the queue row and the
         Downloaded tab's size line — see DownloadQuality.isTranscoded. -->
    <string name="downloads_transcoded_marker">Transcoded</string>
    <string name="downloads_status_queued">Waiting</string>
    <string name="downloads_status_paused">Paused</string>
    <string name="downloads_status_failed">Download failed</string>
    <string name="downloads_status_failed_reason">Download failed: %1$s</string>

    <!-- Empty states and messages -->
    <string name="downloads_empty_downloaded">Nothing downloaded yet. Tap Download on a film or episode to keep it on this device.</string>
    <string name="downloads_empty_queue">The download queue is empty.</string>
    <!-- Shown when the downloads projection itself failed, so neither tab has anything to show.
         Deliberately not phrased as an empty library: nothing was read, so nothing is known. -->
    <string name="downloads_load_failed">Couldn\'t read your downloads. Reopen this screen to try again.</string>
    <string name="downloads_message_delete_failed">Couldn\'t delete that download.</string>
    <string name="downloads_message_action_failed">Couldn\'t update the queue.</string>
    <!-- After "Pause all" when the queue also held transcodes, which cannot be paused without
         discarding them (DownloadItem.isPausable). %1$d paused, %2$d still going. -->
    <plurals name="downloads_message_paused_keeping_transcodes">
        <item quantity="one">Paused %1$d — %2$d transcode keeps downloading (a transcode can\'t be paused).</item>
        <item quantity="other">Paused %1$d — %2$d transcodes keep downloading (a transcode can\'t be paused).</item>
    </plurals>
</resources>
