<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="settings_title">Settings</string>

    <!-- Hub — one row per category, each summarised by its own current state.
         The two state frames are format strings so a language can put the word first; %1$s is
         always a preference's own label, resolved in the same locale at draw time. -->
    <string name="settings_hub_state_on">%1$s on</string>
    <string name="settings_hub_state_off">%1$s off</string>
    <string name="settings_hub_storage_used">%1$s on this device</string>
    <!-- Product name plus its version; neither half is translated. -->
    <string name="settings_hub_version" translatable="false">Jellyboost %1$s</string>

    <!-- Appearance -->
    <string name="settings_section_appearance">Appearance</string>
    <string name="settings_theme">Theme</string>
    <string name="settings_theme_system">Follow the device</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>
    <!-- The dynamic-colour row is not drawn below API 31, where there is no wallpaper palette. -->
    <string name="settings_dynamic_color">Use wallpaper colours</string>
    <string name="settings_dynamic_color_supporting">Take the palette from your wallpaper instead of the Jellyfin blue.</string>

    <!-- Playback -->
    <string name="settings_section_playback">Playback</string>
    <string name="settings_eyebrow_during_playback">During playback</string>
    <string name="settings_eyebrow_subtitles">Subtitles</string>
    <string name="settings_skip_intro">Skip intro</string>
    <string name="settings_skip_outro">Skip outro</string>
    <string name="settings_skip_mode_off">Do nothing</string>
    <string name="settings_skip_mode_show_button">Show a skip button</string>
    <string name="settings_skip_mode_auto">Skip automatically</string>
    <string name="settings_pip">Picture‑in‑picture</string>
    <string name="settings_pip_supporting">Keep playing in a floating window when you leave the app.</string>
    <!-- "ASS/SSA" and "libass" are format and library names; never translated. -->
    <string name="settings_styled_ass">Styled ASS subtitles</string>
    <string name="settings_styled_ass_supporting">Draws ASS/SSA with libass: fonts, positioning and effects. Experimental; applies to the next video you start with nothing else playing.</string>

    <!-- Downloads -->
    <string name="settings_section_downloads">Downloads</string>
    <string name="settings_eyebrow_on_this_device">On this device</string>
    <string name="settings_eyebrow_over_the_network">Over the network</string>
    <string name="settings_eyebrow_quality">Quality</string>
    <string name="settings_wifi_only">Wi‑Fi only</string>
    <string name="settings_wifi_only_supporting">Pause downloads on mobile data.</string>
    <string name="settings_quality">Download quality</string>
    <string name="settings_quality_original">Original file — exact copy, resumable</string>
    <string name="settings_quality_high">High — about 20 Mbps, 1080p</string>
    <string name="settings_quality_medium">Medium — about 8 Mbps, 1080p</string>
    <string name="settings_quality_low">Low — about 3 Mbps, 720p</string>
    <string name="settings_quality_supporting">Anything but the original file is converted by your server as it sends it, so the size shown while it downloads is an estimate and an interrupted transfer starts again.</string>
    <string name="settings_storage_label">Storage</string>
    <string name="settings_storage_summary">%1$s used · %2$s free on this device</string>
    <string name="settings_storage_location">Downloads are kept in %1$s</string>
    <string name="settings_storage_picker">Storage location</string>
    <string name="settings_storage_internal">Internal storage</string>
    <string name="settings_storage_sd_card">SD card</string>
    <string name="settings_storage_volume_free">%1$s free</string>
    <string name="settings_storage_missing">The storage you chose isn\'t available right now, so downloads are going to the location selected below.</string>
    <!-- Spoken-only hint on the row that is already in force while the chosen volume is missing:
         picking it again is the way out of the fallback state, and visually the row just looks
         selected. -->
    <string name="settings_storage_use_this_hint">Choose this one to keep downloads here</string>
    <string name="settings_storage_switch_title">Move downloads?</string>
    <plurals name="settings_storage_switch_message">
        <item quantity="one">Downloads can\'t be moved between locations yet, so the one already on this device will be deleted. You can download it again to the new location.</item>
        <item quantity="other">Downloads can\'t be moved between locations yet, so the %1$d already on this device will be deleted. You can download them again to the new location.</item>
    </plurals>
    <string name="settings_storage_switch_confirm">Delete and switch</string>

    <!-- Network -->
    <string name="settings_section_network">Network</string>
    <string name="settings_offline_mode">Offline mode</string>
    <string name="settings_offline_mode_supporting">Only show media that is already on this device.</string>

    <!-- Account -->
    <string name="settings_section_account">Account</string>
    <string name="settings_account_user">Signed in as</string>
    <string name="settings_account_server">Server</string>
    <string name="settings_account_unknown">Not signed in</string>
    <string name="settings_sign_out">Sign out</string>
    <string name="settings_sign_out_dialog_title">Sign out?</string>
    <string name="settings_sign_out_dialog_message">You\'ll need your server address and password to sign back in.</string>
    <string name="settings_sign_out_delete_downloads">Also delete downloads from this device</string>

    <!-- About -->
    <string name="settings_section_about">About</string>
    <string name="settings_version">App version</string>
    <!-- The row's supporting line is the repository URL itself, which is not a translatable string. -->
    <string name="settings_source_code">Source code</string>
    <string name="settings_open_link_failed">No app on this device can open links.</string>
    <string name="settings_licence">Licence</string>
    <!-- The licence is named by its stewards and is the same name in every language. -->
    <string name="settings_licence_name" translatable="false">GNU General Public License v3.0 or later</string>
    <!-- The SPDX identifier, for the hub summary where the full name will not fit. -->
    <string name="settings_licence_short" translatable="false">GPL-3.0</string>
    <string name="settings_licence_intro">Jellyboost is free software: you may use, study, share and change it under the terms of the GNU General Public License, version 3 or any later version. It comes with no warranty.</string>
    <string name="settings_third_party">Third-party licences</string>
    <string name="settings_third_party_supporting">The open-source components this app is built with.</string>
</resources>
