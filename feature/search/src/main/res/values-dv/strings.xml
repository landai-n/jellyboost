    <string name="search_prompt">ތިޔަ ލައިބްރަރީތަކުގައި ހޯދުމަށް ޓައިޕްކުރޭ.</string>
    <string name="search_no_results">“%1$s” އަކާ ދިމާވާ އެއްޗެއް ނުފެނުނު.</string>

    <string name="search_error_network">ތިޔަ ސަރވަރއަށް ނުދެވުނު. ގުޅުން ބައްލަވާފައި އަލުން މަސައްކަތްކުރައްވާ.</string>
    <string name="search_error_unauthorized">ތިޔަ ސެޝަން ހަމަވެއްޖެ. ކުރިއަށްދިއުމަށް އަލުން ސައިން އިން ކުރައްވާ.</string>
    <string name="search_error_not_found">އެ އައިޓަމް މިހާރު ސަރވަރގައި ނެތް.</string>
    <string name="search_error_server">ސަރވަރއިން ގޯހެއް ފޮނުވިއެވެ.</string>
    <string name="search_error_server_with_code">ސަރވަރއިން ގޯހެއް ފޮނުވިއެވެ (%1$d).</string>
    <string name="search_error_storage">ލޯކަލް ޑޭޓާ ކިޔޭގޮތެއް ނުވި.</string>
    <string name="search_error_unknown">ހޯދުމުގައި ގޯހެއް ދިމާވެއްޖެ.</string>
