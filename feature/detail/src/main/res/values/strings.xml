    <string name="detail_download_remove">Remove</string>
    <string name="detail_play_episode">Play this episode</string>
    <string name="detail_mark_watched">Mark watched</string>
    <string name="detail_mark_unwatched">Mark unwatched</string>
    <string name="detail_add_favorite">Add to favourites</string>
    <string name="detail_remove_favorite">Remove from favourites</string>

    <string name="detail_play_target">Play %1$s</string>
    <string name="detail_resume_target">Resume %1$s</string>

    <!-- Section titles -->
    <string name="detail_section_seasons">Seasons</string>
    <string name="detail_section_next_up">Next up</string>
    <string name="detail_section_episodes">Episodes</string>
    <string name="detail_section_similar">More like this</string>
    <string name="detail_section_cast">Cast</string>
    <!-- An episode page's own "up next" row: the episode that follows it in series order. -->
    <string name="detail_section_next_episode">Next episode</string>
    <!-- The rest of the episode's season, excluding the episode itself. %1$d is the season number. -->
    <string name="detail_section_more_from_season">More from Season %1$d</string>
    <!-- Same row, when the season has no number the server reported. -->
    <string name="detail_section_more_from_season_unnumbered">More from this season</string>

    <!-- Episode origin chips: shortcuts under the title lockup back to the series/season a
         standalone episode page belongs to. The series chip's label is the series name itself;
         only its contentDescription is this resource. -->
    <string name="detail_go_to_series">Go to series %1$s</string>
    <string name="detail_go_to_season">Season %1$d</string>
    <string name="detail_go_to_season_description">Go to season %1$d</string>

    <!-- Metadata -->
    <!-- The item's kind, drawn as the title lockup's eyebrow (uppercased in code). -->
    <string name="detail_type_movie">Movie</string>
    <string name="detail_type_series">Series</string>
    <string name="detail_type_season">Season</string>
    <string name="detail_type_episode">Episode</string>
    <!-- Leads the episode card's number line, uppercased in code. -->
    <string name="detail_episode_number">Episode %1$d</string>
    <!-- The metadata row is one node to a screen reader, so the two facts the eye reads off a glyph
         or a badge outline are qualified in words instead. %1$s is the rating / the certificate. -->
    <string name="detail_meta_rating">Rating %1$s</string>
    <string name="detail_meta_rated">rated %1$s</string>
    <string name="detail_runtime_minutes">%1$d min</string>
    <string name="detail_remaining_minutes">%1$d min left</string>
    <string name="detail_size_on_device">%1$s on device</string>
    <string name="detail_directed_by">Directed by %1$s</string>
    <!-- One cast member, as a screen reader reads the column. %1$s is a person, %2$s their role. -->
    <string name="detail_cast_member_as">%1$s as %2$s</string>
    <plurals name="detail_season_count">
        <item quantity="one">%1$d season</item>
        <item quantity="other">%1$d seasons</item>
    </plurals>
    <plurals name="detail_episode_count">
        <item quantity="one">%1$d episode</item>
        <item quantity="other">%1$d episodes</item>
    </plurals>

    <!-- The collapsed overview on a phone: which state the paragraph is in, and what a tap does.
         TalkBack reads the click label in place of its own "double tap to activate". -->
    <string name="detail_overview_collapsed">Collapsed</string>
    <string name="detail_overview_expanded">Expanded</string>
    <string name="detail_overview_expand">Read full overview</string>
    <string name="detail_overview_collapse">Collapse overview</string>

    <!-- States and messages -->
    <string name="detail_empty">This item is no longer available.</string>
    <string name="detail_message_download_queued">Added to downloads.</string>
    <string name="detail_message_download_failed">Couldn\'t start that download.</string>
    <string name="detail_message_download_deleted">Removed from this device.</string>
    <string name="detail_message_download_delete_failed">Couldn\'t remove that download.</string>
    <plurals name="detail_message_download_cancelled_kept">
        <item quantity="one">Download cancelled — %1$d finished episode kept.</item>
        <item quantity="other">Download cancelled — %1$d finished episodes kept.</item>
    </plurals>
    <string name="detail_message_user_data_failed">Couldn\'t save that. Try again.</string>

    <!-- SyncPlay: what this page can ask the active group to do. In a group the Play / Resume
         button is the group's play, so it takes the first two labels. -->
    <string name="detail_group_play">Play for %1$s</string>
    <string name="detail_group_resume">Resume for %1$s</string>
    <string name="detail_group_play_next">Play next</string>
    <string name="detail_group_add_to_queue">Add to queue</string>
    <string name="detail_message_group_play">Asked the group to play this.</string>
    <string name="detail_message_group_play_next">Queued next for the group.</string>
    <string name="detail_message_group_queued">Added to the group\'s queue.</string>

    <!-- Delete-download confirmation -->
    <string name="detail_delete_download_dialog_title">Delete download?</string>
    <string name="detail_delete_download_dialog_message">This removes it from this device. You can download it again anytime.</string>
    <string name="detail_delete_download_dialog_confirm">Delete</string>

    <!--
      The screen-specific half of the shared failure copy (`AppError.toUiText`); see
      `:core:ui`'s error strings. Only this screen can name what failed to load.
    -->
    <string name="detail_error_unknown">Something went wrong loading this item.</string>
</resources>
