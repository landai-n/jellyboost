<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Empty state -->
    <string name="home_empty_message">Nothing to watch yet. Add media to your libraries on the server.</string>
    <string name="home_empty_refresh">Refresh</string>

    <!-- Section titles -->
    <string name="home_section_my_media">My Media</string>
    <string name="home_section_continue_watching">Continue Watching</string>
    <string name="home_section_next_up">Next Up</string>
    <!-- %1$s is a library name, e.g. "Latest Movies" -->
    <string name="home_section_latest">Latest %1$s</string>

    <!-- Continue-watching hero (2026 refresh) -->
    <string name="home_hero_resume">Resume</string>
    <string name="home_hero_details">Details</string>
    <!-- The hero's age certificate, spoken rather than drawn: the metadata line is one node to a
         screen reader, and a bare "TV-MA" in it says nothing about what it certifies. %1$s is the
         certificate. -->
    <string name="home_hero_rated">Rated %1$s</string>
    <!-- How much of the hero item is left to watch. %1$d is a whole number of minutes. -->
    <plurals name="home_minutes_left">
        <item quantity="one">%1$d min left</item>
        <item quantity="other">%1$d min left</item>
    </plurals>

    <!-- Card overlays and quick access (2026 refresh) -->
    <!-- Time left on a card corner, where only a few characters fit. %1$d is minutes. -->
    <string name="home_time_left_short">%1$dm left</string>
    <!-- Quick-access chip that opens the Downloads tab -->
    <string name="home_quick_access_offline">Offline</string>

    <!--
      The screen-specific half of the shared failure copy (`AppError.toUiText`): every other branch
      comes from `:core:ui`, but "unknown" has to name what failed to load, and only this screen
      knows that. It was a Kotlin literal until audit H8 — invisible to the translation gate, so
      home showed English on all 68 other locales.
    -->
    <string name="home_error_unknown">Something went wrong loading your home screen.</string>
</resources>
