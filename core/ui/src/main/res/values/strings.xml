<?xml version="1.0" encoding="utf-8"?>
<!--
  Copy for the shared batch-selection surface (`SelectionAppBar`, `batchOutcomeText`).

  It lives in `:core:ui` rather than being repeated per feature because the contextual bar and the
  summary snackbar are literally the same interaction on every list that offers them — two copies
  of "Mark watched" are two chances for one screen's wording to drift from the other's.
-->
<resources>
    <!-- Download badge states -->
    <string name="badge_downloaded">Downloaded</string>
    <string name="badge_download_queued">Queued for download</string>
    <string name="badge_download_paused">Download paused</string>
    <string name="badge_download_failed">Download failed</string>
    <!-- The in-flight badge is a ring with no glyph, so its percentage is spoken. -->
    <string name="badge_downloading_progress">Downloading, %1$d%%</string>

    <!-- Media rows and cards -->
    <string name="media_row_see_all">See all</string>
    <!-- Every row on a screen has a "See all"; this is what tells them apart out loud. -->
    <string name="media_row_see_all_section">See all of %1$s</string>
    <string name="media_card_watched">Watched</string>

    <!--
      What a card announces before its title, so a list of results says what kind of thing each one
      is. Containers ("folder") are deliberately absent: naming them says nothing a user needs.
    -->
    <string name="media_card_type_movie">Movie</string>
    <string name="media_card_type_series">Series</string>
    <string name="media_card_type_season">Season</string>
    <string name="media_card_type_episode">Episode</string>
    <string name="media_card_type_library">Library</string>
    <!-- Resume progress, which the card otherwise conveys only as a 3dp bar. -->
    <string name="media_card_progress">%1$d%% watched</string>
    <!-- A bare "8.0" is a number out of nowhere; the scale is half the fact. -->
    <string name="media_card_rating">Rating %1$s out of 10</string>

    <!--
      How many items a library (or a filtered library grid) holds. One resource rather than one per
      feature: the library tiles on Home and on the Libraries tab and the library grid's header all
      label the same number, and three copies are three chances for the wording to drift.
    -->
    <plurals name="library_item_count">
        <item quantity="one">%1$d item</item>
        <item quantity="other">%1$d items</item>
    </plurals>

    <!-- Loading / empty / error states -->
    <string name="state_retry">Retry</string>
    <!-- Spoken by the spinner a screen waits behind, which is otherwise silent. -->
    <string name="state_loading">Loading</string>
    <!-- Spoken state of a button whose action is in flight. -->
    <string name="state_busy">Busy</string>

    <!-- Contextual action bar -->
    <plurals name="selection_count">
        <item quantity="one">%1$d selected</item>
        <item quantity="other">%1$d selected</item>
    </plurals>
    <string name="selection_close">Clear selection</string>
    <string name="selection_select_all">Select all</string>
    <string name="selection_mark_watched">Mark watched</string>
    <string name="selection_mark_unwatched">Mark unwatched</string>
    <string name="selection_download">Download</string>

    <!-- Per-item indicator -->
    <string name="selection_item_selected">Selected</string>
    <string name="selection_item_not_selected">Not selected</string>
    <!-- What a long press on a card does — announced as the gesture's label, not performed blind. -->
    <string name="selection_enter">Select</string>

    <!-- Batch summaries -->
    <plurals name="selection_result_watched">
        <item quantity="one">Marked %1$d watched</item>
        <item quantity="other">Marked %1$d watched</item>
    </plurals>
    <string name="selection_result_watched_partial">Marked %1$d watched, %2$d failed</string>
    <plurals name="selection_result_watched_failed">
        <item quantity="one">Couldn\'t mark %1$d item watched</item>
        <item quantity="other">Couldn\'t mark %1$d items watched</item>
    </plurals>

    <plurals name="selection_result_unwatched">
        <item quantity="one">Marked %1$d unwatched</item>
        <item quantity="other">Marked %1$d unwatched</item>
    </plurals>
    <string name="selection_result_unwatched_partial">Marked %1$d unwatched, %2$d failed</string>
    <plurals name="selection_result_unwatched_failed">
        <item quantity="one">Couldn\'t mark %1$d item unwatched</item>
        <item quantity="other">Couldn\'t mark %1$d items unwatched</item>
    </plurals>

    <plurals name="selection_result_download">
        <item quantity="one">Added %1$d to downloads</item>
        <item quantity="other">Added %1$d to downloads</item>
    </plurals>
    <string name="selection_result_download_partial">Added %1$d to downloads, %2$d failed</string>
    <plurals name="selection_result_download_failed">
        <item quantity="one">Couldn\'t add %1$d item to downloads</item>
        <item quantity="other">Couldn\'t add %1$d items to downloads</item>
    </plurals>
    <string name="selection_result_download_skipped">Added %1$d to downloads — %2$d already on this device</string>
    <plurals name="selection_result_download_all_skipped">
        <item quantity="one">%1$d item is already on this device</item>
        <item quantity="other">%1$d items are already on this device</item>
    </plurals>

    <!--
      The failure taxonomy's shared copy (`AppError.toUiText`). It lives here, not per feature,
      because "can't reach your server" is the same sentence whichever screen asked: five copies
      were five chances to drift, and three of them had already drifted into Kotlin literals no
      translator could see (audit H8). A screen overrides a branch only where its wording genuinely
      differs — the player's server/unknown copy, and every screen's "unknown", which names what
      failed to load.
    -->
    <string name="error_network">Can\'t reach your server. Check your connection and try again.</string>
    <string name="error_unauthorized">Your session expired. Sign in again to continue.</string>
    <string name="error_not_found_item">That item is no longer on the server.</string>
    <string name="error_not_found_library">That library is no longer on the server.</string>
    <string name="error_server">The server returned an error.</string>
    <string name="error_server_with_code">The server returned an error (%1$d).</string>
    <string name="error_storage">Couldn\'t read local data.</string>
    <!--
      The season/episode number, spelled once for the whole app: the detail header's Play button,
      every card's top-left badge, the subtitle line under a card, and what a screen reader speaks
      for all three. Two spellings used to exist — a hardcoded "S1:E4" on cards and this resource
      on the header — so TalkBack said one thing while the screen drew the other (audit DUP-7).
      A resource because the letters are initials of words that translate.
    -->
    <string name="media_episode_label">S%1$d · E%2$d</string>
    <string name="media_episode_label_short">E%1$d</string>
</resources>
