<?xml version="1.0" encoding="utf-8"?>
<!--
    In-app Jellyboost mark. Same geometry as logo/ic_launcher_foreground.svg (the source of
    truth), but with a TIGHT viewport instead of the adaptive-icon safe-zone padding: the
    launcher variant scales the mark to 0.315 inside a 108dp canvas, which would leave a huge
    transparent margin when the logo is placed next to text in a layout.

    Derivation: the mark's ink spans x 176..336 and y 82..216 in the source SVG's coordinates
    (the leftmost point is the round cap of the 12-wide "M182,150" stroke, i.e. 182 - 6). Every
    coordinate below is the SVG's minus (172, 78), which leaves exactly 4 units of padding on
    each side of a 168 x 142 viewport. The gradient stops move with them, so the sweep across
    the mark is pixel-identical to the launcher icon's.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="84dp"
    android:height="71dp"
    android:viewportWidth="168"
    android:viewportHeight="142">
    <path android:pathData="M164,4 C118,18 78,52 60,98 C54,112 52,126 54,138 C90,136 124,112 144,78 C158,54 164,28 164,4 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="164"
                android:endY="138"
                android:startX="4"
                android:startY="4"
                android:type="linear">
                <item
                    android:color="#AA5CC3"
                    android:offset="0" />
                <item
                    android:color="#00A4DC"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M24,38 L74,38"
        android:strokeLineCap="round"
        android:strokeWidth="12">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="164"
                android:endY="138"
                android:startX="4"
                android:startY="4"
                android:type="linear">
                <item
                    android:color="#AA5CC3"
                    android:offset="0" />
                <item
                    android:color="#00A4DC"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M10,72 L54,72"
        android:strokeLineCap="round"
        android:strokeWidth="12">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="164"
                android:endY="138"
                android:startX="4"
                android:startY="4"
                android:type="linear">
                <item
                    android:color="#AA5CC3"
                    android:offset="0" />
                <item
                    android:color="#00A4DC"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M22,110 L42,110"
        android:strokeLineCap="round"
        android:strokeWidth="12">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="164"
                android:endY="138"
                android:startX="4"
                android:startY="4"
                android:type="linear">
                <item
                    android:color="#AA5CC3"
                    android:offset="0" />
                <item
                    android:color="#00A4DC"
                    android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
