<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Shared -->
    <string name="auth_app_name">Jellyboost</string>
    <string name="auth_logo_description" translatable="false">Jellyboost</string>

    <!-- Server setup -->
    <string name="server_setup_title">Connect to server</string>
    <string name="server_setup_tagline">Your Jellyfin library, native on Android.</string>
    <string name="server_setup_discovered_title">Servers on this network</string>
    <string name="server_setup_discovering">Searching the local network…</string>
    <string name="server_setup_no_servers_found">No servers announced themselves. Enter an address below.</string>
    <string name="server_setup_manual_title">Server address</string>
    <string name="server_setup_address_label">Host or URL</string>
    <string name="server_setup_address_placeholder">demo.jellyfin.org or 192.168.1.10:8096</string>
    <string name="server_setup_connect">Connect</string>
    <string name="server_setup_connecting">Contacting the server…</string>
    <string name="server_setup_session_lost">Your saved sign-in could not be restored, so you have been signed out. Please sign in again.</string>
    <!--
      Shown when the server answered over plain http:// and its host is not on the local network
      (audit SEC-10). %1$s is that host. The last sentence names the Connect button
      (server_setup_connect) — translate it to match whatever that button says in this language.

      UNTRANSLATED, DELIBERATELY AND TEMPORARILY. Every other translatable string in this repo
      exists in all 69 locales, which is what lets `MissingTranslation` be an error in
      `config/lint/lint.xml` — and the gate is not being relaxed here: `tools:ignore` names this
      one string and nothing else, so the next untranslated string still fails the build. It is
      *this* string because it is a security warning: a wrong translation of "your token crosses
      the network in the clear" misleads the user about a security property, which is worse than
      the same sentence in English. The 69 translations are owed — see DECISIONS.md 2026-08-08
      and the STATUS.md "owed" list — and this attribute comes out with them.
    -->
    <string name="server_setup_cleartext_warning" tools:ignore="MissingTranslation">%1$s answered over an unencrypted connection. Your sign-in token and everything you watch would cross the network in the clear, where anyone in between can read them. Press Connect again to continue anyway.</string>

    <!-- Login -->
    <string name="login_title">Sign in</string>
    <string name="login_server_version">Version %1$s</string>
    <string name="login_server_version_unknown">Version unknown</string>
    <string name="login_public_users_title">Who is watching?</string>
    <string name="login_username_label">Username</string>
    <string name="login_password_label">Password</string>
    <string name="login_show_password">Show password</string>
    <string name="login_hide_password">Hide password</string>
    <string name="login_sign_in">Sign in</string>
    <string name="login_change_server">Use a different server</string>
    <string name="login_loading">Loading server details…</string>
    <string name="login_or">or</string>

    <!-- Quick Connect -->
    <string name="login_quick_connect">Use Quick Connect</string>
    <string name="login_quick_connect_title">Quick Connect</string>
    <string name="login_quick_connect_instructions">Open Jellyfin on a device you are already signed in on, go to Quick Connect and enter this code.</string>
    <!-- Spoken description of the code boxes, which are one screen-reader node rather than one per
         digit. %1$s is the code with its characters spaced out ("4 8 2 9 1 3") so it is read one
         character at a time instead of as a number. -->
    <string name="login_quick_connect_code_description">Your code is %1$s</string>
    <string name="login_quick_connect_waiting">Waiting for approval…</string>
    <string name="login_quick_connect_cancel">Cancel</string>

    <!-- Errors -->
    <plurals name="auth_error_candidates_tried">
        <item quantity="one">Tried %d candidate address, without success.</item>
        <item quantity="other">Tried %d candidate addresses, without success.</item>
    </plurals>
    <string name="auth_error_unable_to_reach_server">Unable to reach server</string>
    <string name="auth_error_unsupported_version_or_product">Unsupported version or product</string>
    <string name="auth_error_cannot_connect">Connection cannot be established.\nCheck the hostname and your network connection.</string>
    <string name="auth_error_invalid_credentials">Wrong username or password.</string>
    <string name="auth_error_quick_connect_expired">That code expired. Request a new one and try again.</string>
    <string name="auth_error_server">The server answered with an error. Try again.</string>
    <string name="auth_error_server_with_code">The server answered with an error (%1$d). Try again.</string>
</resources>
